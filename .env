# Default school (abnaibi). The portal needs only these four values; titles,
# favicon, theme colour and the palette derive from them (lib/config.ts).
# They are public (inlined into the browser bundle), so this file is committed
# and Vercel builds without dashboard variables. Another school: add
# .env.production.local on its server, or set these four in its Vercel project.
# Quote hex colours: an unquoted # starts a comment in .env files.
NEXT_PUBLIC_API_BASE_URL=https://api.abnacnm.edu.ng
NEXT_PUBLIC_APP_NAME=Student Portal
NEXT_PUBLIC_LOGO_URL=https://storage.prismaforge.name.ng/abnaibi/static_assets/android-chrome-192x192.png
NEXT_PUBLIC_PRIMARY_COLOR="#f44336"


