# Copy to .env.local — all values required (see DOCS.md). Maps VITE_* → NEXT_PUBLIC_*.

NEXT_PUBLIC_API_BASE_URL=https://api.example.com
NEXT_PUBLIC_APP_NAME=Student Portal
NEXT_PUBLIC_APP_SHORT_NAME=Portal
NEXT_PUBLIC_PAGE_TITLE=Student Portal
NEXT_PUBLIC_LOGO_URL=https://example.com/logo.png
NEXT_PUBLIC_LOGO_ALT=School logo
NEXT_PUBLIC_FAVICON_PATH=/favicon.ico
# Quote hex values so # is not treated as a comment start
NEXT_PUBLIC_PRIMARY_COLOR="#f44336"
NEXT_PUBLIC_THEME_COLOR="#f44336"
NEXT_PUBLIC_MANIFEST_BG_COLOR="#ffffff"
NEXT_PUBLIC_AUTH_BACKGROUND_URL=https://example.com/auth-bg.jpg
NEXT_PUBLIC_AUTH_BACKGROUND_URL_DARK=https://example.com/auth-bg-dark.jpg
NEXT_PUBLIC_FOOTER_TEXT="Student portal"
NEXT_PUBLIC_CALENDAR_DEPARTMENT_BG="#e3f2fd"
NEXT_PUBLIC_CALENDAR_DEPARTMENT_HOVER="#bbdefb"
NEXT_PUBLIC_CALENDAR_CLASS_BG="#e8f5e9"
NEXT_PUBLIC_CALENDAR_CLASS_HOVER="#c8e6c9"
NEXT_PUBLIC_CALENDAR_GENERAL_BG="#fff3e0"
NEXT_PUBLIC_CALENDAR_GENERAL_HOVER="#ffe0b2"
