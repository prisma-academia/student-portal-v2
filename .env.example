# One deployment per school. These four values are all the portal needs;
# titles, alt text, favicon, theme colour and the whole palette derive from them.

# API for this school (no trailing slash)
NEXT_PUBLIC_API_BASE_URL=https://api.example.edu.ng
# Shown in the top bar, on the ID card, in page titles and on the sign-in page
NEXT_PUBLIC_APP_NAME=Student Portal
# Square logo (also used as favicon and app icon)
NEXT_PUBLIC_LOGO_URL=https://example.com/logo.png
# School colour, 6-digit hex. Quote it: an unquoted # starts a comment.
NEXT_PUBLIC_PRIMARY_COLOR="#f44336"
